# Copy to .env in the project root. Never commit/share the populated file.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8082
# When behind a proxy, trust only its exact address/network (never public clients).
# FORWARDED_ALLOW_IPS=127.0.0.1
# Optional; defaults to ~/.local/share/salespilot-live. Keep OUTSIDE served assets.
# SALESPILOT_DATA_DIR=/absolute/private/data-directory
# Mandatory in production. Generate with the command in INTEGRATIONS.md.
TOKEN_ENCRYPTION_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
# Copy a currently supported version from your Meta dashboard, e.g. vNN.0.
# Do not literally use vNN.0. No production version is guessed by the service.
META_GRAPH_VERSION=
# Optional if your app requires Facebook Login for Business configuration.
# Configure it for USER access tokens and the documented identity/Page scopes.
META_LOGIN_CONFIG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_API_VERSION=v1.0
X_CLIENT_ID=
X_CLIENT_SECRET=
# Exact public hostnames only; no wildcard, scheme, URL paths or private IPs.
WORDPRESS_ALLOWED_HOSTS=
# Telegram/Discord/WhatsApp resource credentials are entered by the authenticated
# owner in the live page and encrypted in the server database, NOT in demo Store.
